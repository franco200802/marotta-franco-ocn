# URL base del backend (sin "/api"). Dejarla vacía para usar el proxy de Vite,
# que reenvía /api al servidor indicado en API_PROXY_TARGET (el backend no tiene CORS).
VITE_API_URL=

# Destino del proxy de desarrollo/preview. Debe coincidir con el puerto del backend.
API_PROXY_TARGET=http://localhost:3000
