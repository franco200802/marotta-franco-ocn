# Copiar como .env (el .env no se versiona).
PORT=3000

# Obligatorias en producción. En desarrollo, sin JWT_SECRET se genera uno al arrancar.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Administrador inicial. En desarrollo, si no se definen, se usa admin@ocn.local / ocn-admin-dev.
ADMIN_EMAIL=admin@ocn.local
ADMIN_PASSWORD=cambiar-esta-clave

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
